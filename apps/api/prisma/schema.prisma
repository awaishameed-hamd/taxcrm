// CA Firm CRM. Prisma Schema
// PostgreSQL database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  PARTNER
  MANAGER
  TEAM_LEAD
  TRAINEE
  CLIENT
  REPRESENTATIVE
}

// The wall between the two halves of the firm, shown in the UI as Department.
// Tax staff never see audit work and audit staff never see tax work, including
// each other's managers and team leads. BOTH belongs to Partner and Admin, who
// oversee everything.
enum Division {
  TAX
  AUDIT
  BOTH
}

enum MessageType {
  TEXT
  FILE
  IMAGE
  AUDIO
}

enum NotificationType {
  STATUS_CHANGE
  NEW_MESSAGE
  DOCUMENT
  SYSTEM
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  HOLIDAY
}

enum SalesTaxTaskStatus {
  DATA_COLLECTION
  DRAFT_PREPARATION
  CLIENT_REVIEW
  ANNEXURE_UPLOAD
  INCHARGE_REVIEW
  CHALLAN_GENERATED
  SUBMISSION_APPROVAL
  FILED
  COMPLETED
  SENT_BACK
}

enum CustomStepApprover {
  TRAINEE
  MANAGER
}

enum DayType {
  WORKING_DAY
  WEEKEND
  HOLIDAY
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

// ─────────────────────────────────────────────────────────────────────────────
// User (all roles: Partner, Manager, Trainee, Client)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  // Permanent, human-readable identifier (P001, M001, T001, C-0000001).
  // Auto-generated once at creation, never editable. All future linking
  // (filters, reports, assignment) must reference this, not name/email.
  userCode     String   @unique
  email        String   @unique
  phone        String?
  password     String
  fullName     String
  role         Role

  // Which side of the firm this person works on, shown in the UI as Department.
  // Named division because `department` below is already a free-text HR field on
  // the profile form. Role carries seniority, this carries the wall: an audit
  // manager and a tax manager are both MANAGER, they just never see each other's
  // work. BOTH is for Partner and Admin. Existing staff default to TAX, which is
  // all the firm did before audit existed.
  division     Division @default(TAX)
  isActive        Boolean   @default(true)
  hasPortalAccess Boolean   @default(false)
  inviteToken     String?   @unique
  inviteTokenExp  DateTime?

  // Password reset by emailed OTP. The code itself is stored hashed, never in
  // the clear, so a database leak cannot be used to take over accounts.
  // resetOtpTries caps guessing; resetToken is the single-use ticket handed out
  // once the OTP checks out, so the new password is set in a separate step.
  resetOtpHash    String?
  resetOtpExp     DateTime?
  resetOtpTries   Int       @default(0)
  resetToken      String?   @unique
  resetTokenExp   DateTime?
  avatar          String?
  lastSeenAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // ── Detailed profile fields, managed by the dynamic Profile form ──────────
  // Admin can show/hide/reorder/relabel these via Settings > Profile Form,
  // without touching code. See FormFieldSetting.
  firstName            String?
  midName              String?
  lastName             String?
  dateOfBirth          DateTime?
  dateOfJoining         DateTime?
  department           String?
  experience           String?
  cnic                 String?
  permanentAddress     String?  @db.Text
  currentAddress       String?  @db.Text
  basicSalary          Decimal? @db.Decimal(12, 2)
  punctualityAllowance Decimal? @db.Decimal(12, 2)
  travellingAllowance  Decimal? @db.Decimal(12, 2)
  otherAllowance       Decimal? @db.Decimal(12, 2)
  bank                 String?
  accountTitle         String?
  bankAccountNo        String?
  ibanNo               String?
  // Custom admin-added fields land here as {field_key: value}
  extraFields          Json?
  // When true, the user cannot edit their own profile (admin override)
  profileLocked        Boolean  @default(false)
  // When false, attendance is NOT auto-marked and user is excluded from all attendance views
  attendanceApplicable Boolean  @default(true)

  // CLIENT role, extended profile
  clientProfile ClientProfile?

  // TRAINEE role, which team lead manages this trainee (required for TRAINEE)
  teamLeadId   String?
  teamLead     User?   @relation("TeamLeadTrainees", fields: [teamLeadId], references: [id])
  teamTrainees User[]  @relation("TeamLeadTrainees")

  // TRAINEE role, clients assigned to this trainee
  assignedClients ClientProfile[] @relation("TraineeClients")

  // REPRESENTATIVE, if this user is a client representative
  representativeProfile ClientRepresentative? @relation("RepresentativeUser")

  // Chat messages sent
  messages Message[]

  // Notifications received
  notifications Notification[]

  // Refresh tokens
  refreshTokens RefreshToken[]

  // Attendance
  attendances        Attendance[]
  editedAttendances  Attendance[] @relation("AttendanceEdits")
  attendanceOpening  AttendanceOpening?

  // Sales Tax Tasks
  salesTaxTasks        SalesTaxTask[]        @relation("TraineeSalesTaxTasks")
  salesTaxTasksToLead  SalesTaxTask[]        @relation("TeamLeadSalesTaxTasks")
  salesTaxTasksActedOn SalesTaxTaskHistory[] @relation("SalesTaxTaskHistoryActor")
  completedCustomSteps SalesTaxCustomStep[]  @relation("CompletedCustomSteps")

  // General Tasks
  createdTasks    Task[]     @relation("CreatedTasks")
  assignedTasks   Task[]     @relation("AssignedTasks")
  tasksToLead     Task[]     @relation("TeamLeadTasks")
  taskStepsDone   TaskStep[] @relation("TaskStepDoneBy")

  // FBR Notices & Appeals
  fbrCasesCreated  FbrCase[]       @relation("FbrCaseCreator")
  fbrCasesAssigned FbrCase[]       @relation("FbrCaseAssignee")
  fbrCasesToLead   FbrCase[]       @relation("TeamLeadFbrCases")
  fbrAttachments   FbrAttachment[] @relation("FbrAttachmentUploader")
  invoicesCreated  Invoice[]       @relation("InvoiceCreator")
  paymentsRecorded Payment[]       @relation("PaymentRecorder")

  // ── Audit ────────────────────────────────────────────────────────────────
  auditEngagementsCreated   AuditEngagement[]       @relation("AuditEngagementCreator")
  auditEngagementsLed       AuditEngagement[]       @relation("AuditEngagementTeamLead")
  auditEngagementsSignedOff AuditEngagement[]       @relation("AuditEngagementSignatory")
  auditTeamMemberships      AuditTeamMember[]       @relation("AuditTeamMemberships")
  auditWorkingPapers        AuditWorkingPaper[]     @relation("WorkingPaperAssignee")
  auditWpTeamLeadReviews    AuditWorkingPaper[]     @relation("WorkingPaperTeamLeadReviewer")
  auditWpManagerReviews     AuditWorkingPaper[]     @relation("WorkingPaperManagerReviewer")
  auditWpStepsCompleted     AuditWorkingPaperStep[] @relation("WorkingPaperStepCompleter")
  auditReviewPointsRaised   AuditReviewPoint[]      @relation("ReviewPointRaiser")
  auditReviewPointsAnswered AuditReviewPoint[]      @relation("ReviewPointResponder")
  auditReviewPointsCleared  AuditReviewPoint[]      @relation("ReviewPointClearer")
  auditAttachments          AuditAttachment[]       @relation("AuditAttachmentUploader")

  // Leave Applications
  leaveApplications LeaveApplication[] @relation("LeaveApplicant")
  leaveReviews      LeaveApplication[] @relation("LeaveReviewer")

  @@index([role])
  @@index([email])
  @@index([userCode])
  @@index([teamLeadId])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// SequenceCounter, atomic per-role counter backing userCode generation.
// One row per role (e.g. key "userCode:PARTNER"); incremented via upsert,
// which Postgres executes as a single atomic statement, safe under concurrency.
// ─────────────────────────────────────────────────────────────────────────────

model SequenceCounter {
  key   String @id
  value Int    @default(0)

  @@map("sequence_counters")
}

// ─────────────────────────────────────────────────────────────────────────────
// FormFieldSetting, admin-configurable form fields (currently just 'user' /
// Profile form). Lets an admin add/remove/relabel/reorder/resize fields and
// toggle visible/required, all without touching code. Mirrors the Call
// Center CRM's form_field_settings table exactly.
// ─────────────────────────────────────────────────────────────────────────────

model FormFieldSetting {
  id            String   @id @default(cuid())
  formType      String   // 'user' (Profile form), extensible to 'sale' / 'client' later
  fieldKey      String
  label         String
  placeholder   String?
  isVisible     Boolean  @default(true)
  isRequired    Boolean  @default(false)
  fieldType     String   // text | number | select | multiselect | date | textarea | amount_pkr
  options       Json?
  sortOrder     Int      @default(0)
  isCore        Boolean  @default(false) // core fields can be hidden/edited but never deleted
  section       String?
  colSpan       String   @default("third") // full | two_thirds | half | third (out of a 6-col grid)
  textareaRows  Int      @default(3)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([formType, fieldKey])
  @@index([formType])
  @@map("form_field_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// ClientProfile, extra info for CLIENT role users
// ─────────────────────────────────────────────────────────────────────────────

model ClientProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Personal / legal
  cnic          String?  @unique
  dateOfBirth   DateTime?
  address       String?
  city          String?
  province      String?

  // Tax registration
  ntn  String? @unique  // National Tax Number (FBR)
  strn String?          // Sales Tax Registration Number

  // Business info
  businessName String?
  businessType String?  // Individual, Sole Proprietor, Partnership, Pvt Ltd, etc.

  // Assigned trainee (the staff member handling this client)
  traineeId String?
  trainee   User?   @relation("TraineeClients", fields: [traineeId], references: [id])

  // Fiscal year end month: JUNE (Jul–Jun), SEPTEMBER (Oct–Sep), DECEMBER (Jan–Dec)
  yearEnd String @default("DECEMBER")

  // Services enabled for this client
  // Sales Tax: which authorities are active (FBR, PRA, SRB, KPRA, BRA, AJK)
  salesTaxAuthorities  String[] @default([])
  hasWhtService        Boolean  @default(false)
  hasAdvanceTaxService Boolean  @default(false)

  // ── Monthly retainership contract ──────────────────────────────────────────
  // When on, the selected services are billed as one fixed monthly fee instead of
  // per-task. Work covered here still creates a draft invoice so the manager can
  // see it, but they mark it RETAINER_INCLUDED rather than billing the client again.
  hasMonthlyRetainer          Boolean  @default(false)
  retainerAmount              Decimal  @default(0) @db.Decimal(12, 2)
  retainerSalesTax            Boolean  @default(false)
  retainerSalesTaxAuthorities String[] @default([])
  retainerIncomeTax           Boolean  @default(false)
  retainerWht                 Boolean  @default(false)

  // ── Annual billing contract ────────────────────────────────────────────────
  // The same idea billed once a year instead of monthly, tied to yearEnd above:
  // the draft is raised on the 1st of the month after the client's fiscal year
  // ends, so a June year end bills on 1 July for the year that just closed.
  hasAnnualBilling          Boolean  @default(false)
  annualBillingAmount       Decimal  @default(0) @db.Decimal(12, 2)
  annualSalesTax            Boolean  @default(false)
  annualSalesTaxAuthorities String[] @default([])
  annualIncomeTax           Boolean  @default(false)
  annualWht                 Boolean  @default(false)

  // Balance carried in from before the firm started using this system. Kept as the
  // form's stored value and mirrored into an OPENING-kind invoice so it settles
  // through Receive Payment like any other invoice.
  openingBalance     Decimal   @default(0) @db.Decimal(12, 2)
  openingBalanceDate DateTime?

  // Assigned representative
  representativeId String?
  representative   ClientRepresentative? @relation(fields: [representativeId], references: [id])

  // Admin-added dynamic fields land here as { field_key: value }
  extraFields Json?

  salesTaxTasks    SalesTaxTask[]
  salesTaxReturns  SalesTaxReturn[]
  incomeTaxReturns IncomeTaxReturn[]
  generalTasks     Task[]          @relation("TaskClient")
  fbrCases         FbrCase[]
  loginDetails     ClientLoginDetail[]
  invoices         Invoice[]
  payments         Payment[]
  auditEngagements AuditEngagement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([traineeId])
  @@index([representativeId])
  @@map("client_profiles")
}

// ─────────────────────────────────────────────────────────────────────────────
// Invoicing & Payments
// ─────────────────────────────────────────────────────────────────────────────

// What the firm was paid for. Set automatically from the task an invoice was
// drafted against, and picked by hand on a manual one, so revenue can be read
// per service rather than only per client.
enum InvoiceService {
  SALES_TAX
  INCOME_TAX
  WHT
  NOTICES_APPEALS
  RETAINERSHIP // a monthly or annual fee, covering whatever the contract names
  AUDIT        // an audit engagement, billed when it is signed off
  OTHER
}

enum InvoiceKind {
  TASK      // auto-drafted when a task completes
  RETAINER  // monthly retainership fee
  ANNUAL    // yearly billing fee, raised after the client's fiscal year end
  MANUAL    // created by hand
  OPENING   // the client's opening balance, carried as an invoice so it can be paid
}

enum InvoiceStatus {
  DRAFT             // waiting on the manager to price it and send it
  SENT              // issued to the client, awaiting payment
  OVERDUE           // sent, still unpaid, past its due date
  PARTIALLY_PAID
  PAID
  RETAINER_INCLUDED // work covered by the monthly retainer, never billed separately
  ANNUAL_INCLUDED   // work covered by the yearly billing fee, never billed separately
  CANCELLED
}

enum PaymentMethod {
  CASH
  CHEQUE
  BANK_TRANSFER
  ONLINE
  OTHER
}

// What to do with money received beyond what the payment was applied to
enum OverpaymentType {
  ADVANCE // sits as credit on the client's account against future invoices
  BONUS   // the client meant us to keep it, income, not a liability
}

model Invoice {
  id            String @id @default(cuid())
  invoiceNumber String @unique

  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  kind   InvoiceKind   @default(TASK)
  status InvoiceStatus @default(DRAFT)

  // Nullable: invoices raised before this existed carry no service until one is
  // picked, and there is no sensible value to invent for them.
  service InvoiceService?

  // Which half of the firm raised it. Audit and tax bill separately and meet
  // only at partner level, so an invoice has to know which side it came from.
  // Everything raised before audit existed was tax work.
  division Division @default(TAX)

  // Source task, set for TASK invoices only, at most one invoice per task
  taskId String?       @unique
  task   SalesTaxTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  // Billing period, set for RETAINER and ANNUAL invoices only. ANNUAL covers a
  // whole year and stores month 0 rather than null, because Postgres treats
  // nulls as distinct and the unique index below would stop catching duplicates.
  periodMonth Int?
  periodYear  Int?

  description String? @db.Text

  // amount is the billed total and is always subtotal + salesTax + outOfPocket ,
  // recomputed on write so the parts and the total can never disagree.
  subtotal    Decimal @default(0) @db.Decimal(12, 2) // professional fee
  salesTax    Decimal @default(0) @db.Decimal(12, 2) // sales tax we charged the client
  outOfPocket Decimal @default(0) @db.Decimal(12, 2) // filing fees, challans, travel etc.
  amount      Decimal @default(0) @db.Decimal(12, 2)

  // How the invoice got settled. amountPaid is cash; the rest are non-cash, the client
  // took a discount or withheld tax at source. All four are rolled up from the payment
  // allocations, and the invoice is PAID once they add up to `amount`.
  amountPaid        Decimal @default(0) @db.Decimal(12, 2)
  discountTotal     Decimal @default(0) @db.Decimal(12, 2)
  incomeTaxWithheld Decimal @default(0) @db.Decimal(12, 2)
  salesTaxWithheld  Decimal @default(0) @db.Decimal(12, 2)

  issueDate DateTime  @default(now())
  dueDate   DateTime?
  sentAt    DateTime?
  paidAt    DateTime?

  notes String? @db.Text

  createdById String?
  createdBy   User?   @relation("InvoiceCreator", fields: [createdById], references: [id])

  allocations PaymentAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Stops the monthly cron from double-billing a client for the same period
  @@unique([clientId, kind, periodMonth, periodYear])
  @@index([clientId])
  @@index([status])
  @@index([issueDate])
  @@index([service])
  @@index([division])
  @@map("invoices")
}

// Money received from a client. It belongs to the client, not to an invoice ,
// clients often pay in advance before anything has been billed. Whatever isn't
// allocated to an invoice sits as unapplied credit and shows as a negative balance.
model Payment {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // A payment's own reference, PMT-2026-0001. The ledger used to label a payment
  // with the invoice numbers it was applied against, which made a payment row
  // indistinguishable from an invoice row. Nullable for payments recorded before
  // this existed.
  paymentNumber String? @unique

  amount    Decimal       @db.Decimal(12, 2) // cash actually received
  method    PaymentMethod @default(BANK_TRANSFER)
  reference String?       // cheque no, transaction id, etc.
  proofUrl  String?
  paidAt    DateTime      @default(now())
  notes     String?       @db.Text

  // Only matters when more came in than was applied to invoices
  overpaymentType OverpaymentType @default(ADVANCE)

  recordedById String?
  recordedBy   User?   @relation("PaymentRecorder", fields: [recordedById], references: [id])

  allocations PaymentAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([paidAt])
  @@map("payments")
}

// How much of a payment was put against a given invoice. An advance payment starts
// with none of these and gets them once there's an invoice to apply it to.
model PaymentAllocation {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(12, 2) // cash out of this payment put against the invoice

  // Non-cash settlement agreed at the same time: a discount the client took, and tax
  // they withheld at source. These close out the invoice without money changing hands.
  discount          Decimal @default(0) @db.Decimal(12, 2)
  incomeTaxWithheld Decimal @default(0) @db.Decimal(12, 2)
  salesTaxWithheld  Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@unique([paymentId, invoiceId])
  @@index([paymentId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

// IRIS (or other authority portal) login credentials, one row per (client, authority).
// Kept in sync with ClientProfile.salesTaxAuthorities: a row is auto-created for every
// authority the client has selected (or a single FBR row if none are selected).
model ClientLoginDetail {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  authority String
  loginId   String?
  password  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, authority])
  @@index([clientId])
  @@map("client_login_details")
}

// ─────────────────────────────────────────────────────────────────────────────
// Client Representative, person who represents one or more clients
// ─────────────────────────────────────────────────────────────────────────────

model ClientRepresentative {
  id       String @id @default(cuid())
  fullName String
  email    String @unique
  phone    String?
  cnic     String?

  // Portal access
  isActive        Boolean @default(true)
  hasPortalAccess Boolean @default(false)
  userId          String? @unique
  user            User?   @relation("RepresentativeUser", fields: [userId], references: [id])

  clients ClientProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("client_representatives")
}

// ─────────────────────────────────────────────────────────────────────────────
// Conversation + Message. WhatsApp-style chat
// ─────────────────────────────────────────────────────────────────────────────

model Conversation {
  id String @id @default(cuid())

  // Group chats reuse this model: a direct chat has two participants and no
  // name; a group is flagged, named, and can hold many participants.
  isGroup     Boolean @default(false)
  name        String?
  createdById String?

  participants ConversationParticipant[]
  messages     Message[]

  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String

  // Group admins can rename the group and add or remove members.
  isAdmin    Boolean   @default(false)
  lastReadAt DateTime?

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id])

  content       String      @db.Text
  type          MessageType @default(TEXT)
  attachmentUrl String?      // relative path for file/image messages

  // Per-user "delete for me": ids of participants who removed this message from
  // their own view. The row survives until everyone has deleted it.
  deletedForUserIds String[] @default([])

  replyToId String?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([replyToId])
  @@map("messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// Notification
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title  String
  body   String
  type   NotificationType
  data   Json?

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// RefreshToken, for JWT rotation
// ─────────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// WorkingDay. HR sets up each month's schedule
// ─────────────────────────────────────────────────────────────────────────────

model WorkingDay {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  dayType     DayType  @default(WORKING_DAY)
  leaveReason String?

  // Override per-day reporting time (HH:MM). Falls back to AttendanceSetting
  reportingTimeOverride String?

  attendances Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date])
  @@index([date])
  @@map("working_days")
}

// ─────────────────────────────────────────────────────────────────────────────
// Attendance, auto-marked on login; editable by manager/partner
// ─────────────────────────────────────────────────────────────────────────────

model Attendance {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workingDayId String?
  workingDay   WorkingDay? @relation(fields: [workingDayId], references: [id])

  date      DateTime         @db.Date
  loginTime DateTime?
  logoutTime DateTime?

  status      AttendanceStatus @default(PRESENT)
  isLate      Boolean          @default(false)
  lateMinutes Int?

  // HR edits
  editedById String?
  editedBy   User?   @relation("AttendanceEdits", fields: [editedById], references: [id])
  notes      String?

  // Approval flow for leave / absent correction
  approvalStatus String   @default("approved")
  approvedById   String?
  approvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([userId])
  @@map("attendances")
}

// AttendanceOpening, one-time historical opening balance per user
// ─────────────────────────────────────────────────────────────────────────────

model AttendanceOpening {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  presents    Int      @default(0)
  late        Int      @default(0)
  absents     Int      @default(0)
  leaves      Int      @default(0)
  workingDays Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("attendance_openings")
}

// ─────────────────────────────────────────────────────────────────────────────
// AttendanceSetting, admin-configurable key-value settings
// Keys: reporting_time, grace_period_minutes, cutoff_time, auto_mark_on_login, timezone
// ─────────────────────────────────────────────────────────────────────────────

model AttendanceSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  label String?

  updatedAt DateTime @updatedAt

  @@map("attendance_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// LeaveApplication, staff apply for leave; approved by line manager
// ─────────────────────────────────────────────────────────────────────────────

model LeaveApplication {
  id          String   @id @default(cuid())
  applicantId String
  applicant   User     @relation("LeaveApplicant", fields: [applicantId], references: [id], onDelete: Cascade)

  leaveType   String   // sick | casual | annual | other
  fromDate    DateTime @db.Date
  toDate      DateTime @db.Date
  days        Int
  reason      String   @db.Text

  status          String    @default("pending")  // pending | approved | rejected
  reviewedById    String?
  reviewedBy      User?     @relation("LeaveReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicantId])
  @@index([status])
  @@map("leave_applications")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// SalesTaxTask, one task per client per tax period (month/year)
// Auto-created on 1st of every month for clients with hasSalesTaxService=true
// ─────────────────────────────────────────────────────────────────────────────

model SalesTaxTask {
  id       String @id @default(cuid())

  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  traineeId String
  trainee   User   @relation("TraineeSalesTaxTasks", fields: [traineeId], references: [id])

  // Which Team Lead owns this task's approval. Null means "follow the trainee's
  // current team lead", which is what auto-generated tasks want. A value is only
  // stored when the task was deliberately routed elsewhere, so a Team Lead who
  // raises work for someone outside their own team still gets it back to approve.
  teamLeadId String?
  teamLead   User?   @relation("TeamLeadSalesTaxTasks", fields: [teamLeadId], references: [id])

  // Tax period
  periodMonth Int  // 1–12
  periodYear  Int  // e.g. 2026

  status    SalesTaxTaskStatus @default(DATA_COLLECTION)
  dueDate   DateTime?

  // Step 4. Annexure uploads (file paths)
  annexureA String?
  annexureC String?

  // Step 6. Challan/PSID
  psid          String?
  challanAmount Decimal? @db.Decimal(12, 2)

  // Step 8. Filing
  feeInvoiceNo     String?
  feeInvoiceAmount Decimal? @db.Decimal(12, 2)
  filedAt          DateTime?

  priority     TaskPriority @default(MEDIUM)
  assignerNote String?      @db.Text
  skippedSteps String[]     @default([])

  // Task type: SALES_TAX | INCOME_TAX | WHT
  taskType   String @default("SALES_TAX")

  // Tax Authority (FBR, PRA, SRB, KPRA, BRA, AJK), only used for SALES_TAX
  authority  String @default("FBR")
  // Return Type (ORIGINAL / REVISED)
  returnType String @default("ORIGINAL")

  // Last manager comment (send back reason)
  managerComment String? @db.Text

  // Frozen snapshot of pipeline step config at completion time
  stepsSnapshot  Json?

  history          SalesTaxTaskHistory[]
  customSteps      SalesTaxCustomStep[]
  salesTaxReturn   SalesTaxReturn?
  incomeTaxReturn  IncomeTaxReturn?
  invoice          Invoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, periodMonth, periodYear, authority, returnType, taskType])
  @@index([traineeId])
  @@index([teamLeadId])
  @@index([status])
  @@index([periodYear, periodMonth])
  @@index([clientId])
  @@index([createdAt])
  @@map("sales_tax_tasks")
}

// ── Admin-configurable pipeline step labels per tax type ──────────────────────
model PipelineStepConfig {
  id           String   @id @default(cuid())
  taskType     String   // SALES_TAX | INCOME_TAX | WHT
  stepKey      String   // DATA_COLLECTION | DRAFT_PREPARATION | ...
  label        String
  description  String?  @db.Text
  approvedBy   String   @default("TRAINEE") // TRAINEE | MANAGER
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([taskType, stepKey])
  @@map("pipeline_step_configs")
}

// ─────────────────────────────────────────────────────────────────────────────
// SalesTaxTaskHistory, full audit trail of every status transition
// ─────────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// Task, general task management (create for self or assign to others)
// ─────────────────────────────────────────────────────────────────────────────

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?

  // Tax category: sales_tax | income_tax | wht | notices
  taxType     String       @default("general")
  authority   String?

  // Optional client link
  clientId    String?
  client      ClientProfile? @relation("TaskClient", fields: [clientId], references: [id])

  createdById String
  createdBy   User   @relation("CreatedTasks", fields: [createdById], references: [id])

  assignedToId String
  assignedTo   User   @relation("AssignedTasks", fields: [assignedToId], references: [id])

  // Team Lead this task reports to, see the note on SalesTaxTask.teamLeadId
  teamLeadId String?
  teamLead   User?   @relation("TeamLeadTasks", fields: [teamLeadId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedToId])
  @@index([teamLeadId])
  @@index([createdById])
  @@index([status])
  @@index([taxType])
  @@index([clientId])
  @@index([createdAt])
  @@map("tasks")

  steps       TaskStep[]
}

model TaskStep {
  id            String    @id @default(cuid())
  taskId        String
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  approvedBy    String    @default("TRAINEE")
  isDone        Boolean   @default(false)
  order         Int       @default(0)
  comment       String?
  attachmentUrl String?
  doneAt        DateTime?
  doneById      String?
  doneBy        User?     @relation("TaskStepDoneBy", fields: [doneById], references: [id])
  createdAt     DateTime  @default(now())

  @@index([taskId])
  @@map("task_steps")
}

model SalesTaxCustomStep {
  id          String             @id @default(cuid())
  taskId      String
  task        SalesTaxTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title       String
  description String?            @db.Text
  approvedBy  CustomStepApprover @default(TRAINEE)
  insertAfter String             // fixed step key e.g. "DATA_COLLECTION"
  isCompleted Boolean            @default(false)
  isDeleted   Boolean            @default(false)
  completedAt   DateTime?
  completedById String?
  completedBy   User?            @relation("CompletedCustomSteps", fields: [completedById], references: [id])
  // Set when this step was seeded from a global PipelineStepConfig (null = task-specific custom step)
  pipelineStepConfigId String?
  createdAt   DateTime           @default(now())

  @@index([taskId])
  @@map("sales_tax_custom_steps")
}

// ─────────────────────────────────────────────────────────────────────────────
// RolePermission, admin-configurable per-role feature toggles
// ─────────────────────────────────────────────────────────────────────────────

model RolePermission {
  id        String   @id @default(cuid())
  role      String   // MANAGER, TEAM_LEAD, TRAINEE
  feature   String   // feature key
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([role, feature])
  @@map("role_permissions")
}

// ── SalesTaxReturn, summary data entered when FILED step is completed ────────
model SalesTaxReturn {
  id          String        @id @default(cuid())
  clientId    String
  client      ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  taskId      String?       @unique
  task        SalesTaxTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  periodMonth Int
  periodYear  Int
  authority   String  @default("FBR")
  returnType  String  @default("ORIGINAL")

  // Sales
  standardSales        Decimal? @db.Decimal(14, 2)
  outputTaxStandard    Decimal? @db.Decimal(14, 2)
  reducedRateSales     Decimal? @db.Decimal(14, 2)
  outputTaxReduced     Decimal? @db.Decimal(14, 2)
  exemptSales          Decimal? @db.Decimal(14, 2)
  zeroRatedSales       Decimal? @db.Decimal(14, 2)

  // Purchases
  standardPurchases     Decimal? @db.Decimal(14, 2)
  inputTaxStandard      Decimal? @db.Decimal(14, 2)
  reducedRatePurchases  Decimal? @db.Decimal(14, 2)
  inputTaxReduced       Decimal? @db.Decimal(14, 2)
  unregisteredPurchases Decimal? @db.Decimal(14, 2)
  exemptPurchases       Decimal? @db.Decimal(14, 2)
  zeroRatedPurchases    Decimal? @db.Decimal(14, 2)

  // Tax computation
  normalTaxPayable  Decimal? @db.Decimal(14, 2)
  furtherTaxPayable Decimal? @db.Decimal(14, 2)
  taxCarryForward   Decimal? @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, periodMonth, periodYear, authority, returnType])
  @@index([clientId])
  @@map("sales_tax_returns")
}

// ── IncomeTaxReturn, summary data entered when INCOME_TAX FILED step completes ─
model IncomeTaxReturn {
  id         String        @id @default(cuid())
  clientId   String
  client     ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  taskId     String?       @unique
  task       SalesTaxTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  periodYear Int

  totalProfitLoss        Decimal? @db.Decimal(14, 2)
  profitLossExempt       Decimal? @db.Decimal(14, 2)
  amountSubjectNormal    Decimal? @db.Decimal(14, 2)
  normalIncomeTax        Decimal? @db.Decimal(14, 2)
  turnoverTax            Decimal? @db.Decimal(14, 2)
  taxOnAccountingProfit  Decimal? @db.Decimal(14, 2)
  differenceMinimumTax   Decimal? @db.Decimal(14, 2)
  superTax               Decimal? @db.Decimal(14, 2)
  taxChargeable          Decimal? @db.Decimal(14, 2)
  admittedIncomeTax      Decimal? @db.Decimal(14, 2)
  refundableIncomeTax    Decimal? @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, periodYear])
  @@index([clientId])
  @@map("income_tax_returns")
}

model SalesTaxTaskHistory {
  id     String       @id @default(cuid())
  taskId String
  task   SalesTaxTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  fromStatus SalesTaxTaskStatus?
  toStatus   SalesTaxTaskStatus

  actedById String
  actedBy   User   @relation("SalesTaxTaskHistoryActor", fields: [actedById], references: [id])

  comment    String? @db.Text
  attachment String?

  createdAt DateTime @default(now())

  @@index([taskId])
  @@map("sales_tax_task_history")
}

// ─────────────────────────────────────────────────────────────────────────────
// FBR Notices & Appeals, case management
// ─────────────────────────────────────────────────────────────────────────────

enum FbrEntryPoint {
  FRESH_NOTICE
  FURTHER_NOTICE_ONLY
  DIRECT_APPEAL
  HEARING_ONLY
}

enum FbrCaseStage {
  NOTICE
  APPEAL
  STAY
  HIGHER_FORUM
  CLOSED
}

enum FbrSubmissionMethod {
  IRIS
  MANUAL
  BOTH   // filed on IRIS and a physical/manual copy at the same time
}

enum FbrNoticeOutcome {
  PENDING
  ACCEPTED
  FURTHER_NOTICE
  ORDER_AGAINST
}

enum FbrAppealType {
  CIR_APPEALS
  ATIR
  HIGH_COURT
}

enum FbrAppealOutcome {
  PENDING
  IN_FAVOR
  AGAINST
  HIGHER_FORUM
}

enum FbrStayOutcome {
  PENDING
  GRANTED
  REJECTED
}

enum FbrHearingOutcome {
  PENDING
  ADJOURNED
  DECIDED
}

model FbrCase {
  id         String @id @default(cuid())
  caseNumber String @unique

  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  entryPoint   FbrEntryPoint
  currentStage FbrCaseStage @default(NOTICE)
  taxType       String
  taxYear       String?
  noticeSection String?
  noticeNumber  String?
  description  String? @db.Text
  authority    String  @default("FBR")

  assignedToId String?
  assignedTo   User?   @relation("FbrCaseAssignee", fields: [assignedToId], references: [id])

  // Team Lead this case reports to, see the note on SalesTaxTask.teamLeadId
  teamLeadId String?
  teamLead   User?   @relation("TeamLeadFbrCases", fields: [teamLeadId], references: [id])

  createdById String
  createdBy   User   @relation("FbrCaseCreator", fields: [createdById], references: [id])

  noticeRounds     FbrNoticeRound[]
  appeal           FbrAppeal?
  stayApplications FbrStayApplication[]
  hearings         FbrHearing[]

  closedAt     DateTime?
  closedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([currentStage])
  @@index([assignedToId])
  @@index([teamLeadId])
  @@index([createdAt])
  @@map("fbr_cases")
}

model FbrNoticeRound {
  id     String  @id @default(cuid())
  caseId String
  case   FbrCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  roundNumber Int @default(1)

  noticeDate           DateTime?
  noticeLoggedById     String?
  dueDate              DateTime?
  adjournmentApplied   Boolean   @default(false)
  adjournmentAppliedById String?
  adjournmentDate      DateTime?

  docListCreatedAt    DateTime?
  docListCreatedById  String?
  docListApprovedAt   DateTime?
  docListApprovedById String?
  draftPreparedAt     DateTime?
  draftPreparedById   String?
  internalReviewedAt  DateTime?
  internalReviewById  String?
  partnerApprovedAt   DateTime?
  partnerApprovedById String?

  submissionMethod FbrSubmissionMethod?
  submittedAt      DateTime?
  submittedById    String?
  submissionRef    String?

  outcome       FbrNoticeOutcome @default(PENDING)
  outcomeById   String?
  orderDate     DateTime?
  challanPaid   Boolean          @default(false)
  challanPaidAt DateTime?
  challanRef    String?

  sentBackComment String? @db.Text

  notes       String? @db.Text
  attachments FbrAttachment[]

  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@map("fbr_notice_rounds")
}

model FbrAppeal {
  id     String  @id @default(cuid())
  caseId String  @unique
  case   FbrCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  appealType         FbrAppealType @default(CIR_APPEALS)
  isLate             Boolean       @default(false)
  condonationFiled   Boolean       @default(false)
  condonationFiledById String?

  feeChallanRef String?
  feePaidAt     DateTime?

  submissionMethod     FbrSubmissionMethod?
  groundsPreparedAt    DateTime?
  groundsPreparedById  String?
  internalReviewedAt   DateTime?
  internalReviewById   String?
  partnerApprovedAt    DateTime?
  partnerApprovedById  String?
  submittedAt          DateTime?
  submittedById        String?
  submissionRef        String?

  hearings    FbrHearing[]
  attachments FbrAttachment[]

  outcome       FbrAppealOutcome @default(PENDING)
  outcomeById   String?
  orderDate     DateTime?
  challanPaid   Boolean          @default(false)
  challanPaidAt DateTime?
  challanRef    String?

  sentBackComment String? @db.Text

  closedAt DateTime?
  notes    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("fbr_appeals")
}

model FbrStayApplication {
  id     String  @id @default(cuid())
  caseId String
  case   FbrCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  triggeredAt DateTime @default(now())
  reason      String?  @db.Text

  reviewedAt   DateTime?
  reviewedById String?

  submissionMethod FbrSubmissionMethod?
  submittedAt      DateTime?
  submittedById    String?
  submissionRef    String?

  hearingDate DateTime?

  outcome     FbrStayOutcome @default(PENDING)
  outcomeById String?
  decidedAt   DateTime?

  resumedAt   DateTime?
  resumedById String?

  attachments FbrAttachment[]
  notes       String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@map("fbr_stay_applications")
}

model FbrHearing {
  id     String  @id @default(cuid())
  caseId String
  case   FbrCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  appealId String?
  appeal   FbrAppeal? @relation(fields: [appealId], references: [id], onDelete: SetNull)

  scheduledDate DateTime
  adjournedTo   DateTime?

  outcome FbrHearingOutcome @default(PENDING)
  notes   String? @db.Text

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@map("fbr_hearings")
}

model FbrAttachment {
  id String @id @default(cuid())

  noticeRoundId String?
  noticeRound   FbrNoticeRound? @relation(fields: [noticeRoundId], references: [id], onDelete: Cascade)

  appealId String?
  appeal   FbrAppeal? @relation(fields: [appealId], references: [id], onDelete: Cascade)

  stayId String?
  stay   FbrStayApplication? @relation(fields: [stayId], references: [id], onDelete: Cascade)

  label    String?
  url      String
  fileType String @default("other")

  uploadedById String
  uploadedBy   User   @relation("FbrAttachmentUploader", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@index([noticeRoundId])
  @@index([appealId])
  @@index([stayId])
  @@map("fbr_attachments")
}

model FbrNoticeSection {
  id        String  @id @default(cuid())
  taxType   String
  section   String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())

  @@unique([taxType, section])
  @@index([taxType])
  @@map("fbr_notice_sections")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// AUDIT
//
// A tax task is linear and has one owner. An audit is a team working in parallel
// on one file, so the shape is different:
//
//   AuditEngagement            the job, with a team and a lifecycle
//     â””â”€â”€ AuditWorkingPaper    one per area (PPE, Revenue...), one owner each
//           â”œâ”€â”€ AuditWorkingPaperStep   the procedure checklist inside it
//           â””â”€â”€ AuditReviewPoint        reviewer queries the preparer clears
//
// The engagement cannot be signed off while any review point is open, and
// cannot complete until the signed financial statements and the audit report
// are attached. Those two gates are the point of the module.
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

enum AuditTaskType {
  EXTERNAL_AUDIT
  INTERNAL_AUDIT
  FS_PREPARATION
  GENERAL
}

// ISA-shaped phases. Fieldwork is where the working papers live; everything
// before it is planning and everything after is review and reporting.
enum AuditPhase {
  ACCEPTANCE
  PLANNING
  FIELDWORK
  REVIEW
  COMPLETION
  REPORTING
  COMPLETED
}

enum AuditEngagementStatus {
  IN_PROGRESS
  SENT_BACK
  COMPLETED
  CANCELLED
}

// Where a working paper sits in Member to Team Lead to Manager.
enum WorkingPaperStatus {
  NOT_STARTED
  IN_PROGRESS
  AWAITING_DATA
  SUBMITTED_FOR_REVIEW
  TEAM_LEAD_REVIEW
  MANAGER_REVIEW
  SENT_BACK
  COMPLETED
}

enum AuditTeamRole {
  TEAM_LEAD
  MEMBER
}

enum ReviewPointStatus {
  OPEN
  ANSWERED
  CLEARED
}

enum AuditAreaGroup {
  BALANCE_SHEET
  PROFIT_AND_LOSS
  OTHER
}

// The standard heads a working paper can cover. Seeded on boot and editable by
// an admin, the same way PipelineStepConfig works for tax.
model AuditAreaConfig {
  id        String         @id @default(cuid())
  name      String
  group     AuditAreaGroup
  sortOrder Int            @default(0)
  isActive  Boolean        @default(true)

  workingPapers AuditWorkingPaper[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, group])
  @@index([group, sortOrder])
  @@map("audit_area_configs")
}

model AuditEngagement {
  id       String        @id @default(cuid())
  taskType AuditTaskType @default(EXTERNAL_AUDIT)

  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  title       String
  description String? @db.Text

  // The year under audit, named by the date the financial year ends
  periodEndDate DateTime
  periodLabel   String?

  phase  AuditPhase            @default(ACCEPTANCE)
  status AuditEngagementStatus @default(IN_PROGRESS)

  // Planning figures. Kept on the engagement because every working paper is
  // judged against them.
  materiality            Decimal? @db.Decimal(14, 2)
  performanceMateriality Decimal? @db.Decimal(14, 2)
  riskAssessment         String?  @db.Text

  // Raised by a manager, who also picks the team and names its lead
  createdById String?
  createdBy   User?   @relation("AuditEngagementCreator", fields: [createdById], references: [id])

  teamLeadId String?
  teamLead   User?   @relation("AuditEngagementTeamLead", fields: [teamLeadId], references: [id])

  // Completion gates. An engagement cannot reach COMPLETED until both are
  // attached, which is why they are first-class fields and not just files.
  financialStatementsFileId String?
  auditReportFileId         String?

  startedAt      DateTime?
  dueDate        DateTime?
  completedAt    DateTime?
  sentBackReason String?   @db.Text

  // Partner signs off at the end
  signedOffById String?
  signedOffBy   User?     @relation("AuditEngagementSignatory", fields: [signedOffById], references: [id])
  signedOffAt   DateTime?

  team          AuditTeamMember[]
  workingPapers AuditWorkingPaper[]
  attachments   AuditAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([teamLeadId])
  @@index([periodEndDate])
  @@map("audit_engagements")
}

model AuditTeamMember {
  id           String          @id @default(cuid())
  engagementId String
  engagement   AuditEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("AuditTeamMemberships", fields: [userId], references: [id], onDelete: Cascade)

  teamRole AuditTeamRole @default(MEMBER)

  createdAt DateTime @default(now())

  // One row per person per engagement, so a member cannot be added twice
  @@unique([engagementId, userId])
  @@index([userId])
  @@map("audit_team_members")
}

model AuditWorkingPaper {
  id           String          @id @default(cuid())
  engagementId String
  engagement   AuditEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  areaId String?
  area   AuditAreaConfig? @relation(fields: [areaId], references: [id], onDelete: SetNull)

  // Kept alongside areaId so a renamed or deleted area never rewrites history
  areaName String

  assignedToId String?
  assignedTo   User?   @relation("WorkingPaperAssignee", fields: [assignedToId], references: [id])

  status WorkingPaperStatus @default(NOT_STARTED)

  // Lead schedule figures, what makes this an audit file rather than a checklist
  currentYearAmount Decimal? @db.Decimal(14, 2)
  priorYearAmount   Decimal? @db.Decimal(14, 2)

  conclusion String?   @db.Text
  dueDate    DateTime?

  submittedAt DateTime?

  teamLeadReviewedById String?
  teamLeadReviewedBy   User?     @relation("WorkingPaperTeamLeadReviewer", fields: [teamLeadReviewedById], references: [id])
  teamLeadReviewedAt   DateTime?

  managerReviewedById String?
  managerReviewedBy   User?     @relation("WorkingPaperManagerReviewer", fields: [managerReviewedById], references: [id])
  managerReviewedAt   DateTime?

  completedAt DateTime?

  steps        AuditWorkingPaperStep[]
  reviewPoints AuditReviewPoint[]
  attachments  AuditAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([engagementId])
  @@index([assignedToId])
  @@index([status])
  @@map("audit_working_papers")
}

model AuditWorkingPaperStep {
  id             String            @id @default(cuid())
  workingPaperId String
  workingPaper   AuditWorkingPaper @relation(fields: [workingPaperId], references: [id], onDelete: Cascade)

  name      String
  sortOrder Int    @default(0)

  isDone        Boolean   @default(false)
  completedById String?
  completedBy   User?     @relation("WorkingPaperStepCompleter", fields: [completedById], references: [id])
  completedAt   DateTime?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workingPaperId, sortOrder])
  @@map("audit_working_paper_steps")
}

// A reviewer's query against a working paper. The engagement cannot be signed
// off while any of these is still open, which is what keeps review inside the
// CRM instead of in a WhatsApp thread.
model AuditReviewPoint {
  id             String            @id @default(cuid())
  workingPaperId String
  workingPaper   AuditWorkingPaper @relation(fields: [workingPaperId], references: [id], onDelete: Cascade)

  raisedById String
  raisedBy   User   @relation("ReviewPointRaiser", fields: [raisedById], references: [id])

  note   String            @db.Text
  status ReviewPointStatus @default(OPEN)

  response      String?   @db.Text
  respondedById String?
  respondedBy   User?     @relation("ReviewPointResponder", fields: [respondedById], references: [id])
  respondedAt   DateTime?

  clearedById String?
  clearedBy   User?     @relation("ReviewPointClearer", fields: [clearedById], references: [id])
  clearedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workingPaperId, status])
  @@map("audit_review_points")
}

// Files live on Backblaze B2 like everything else; this row is the reference.
model AuditAttachment {
  id String @id @default(cuid())

  engagementId String?
  engagement   AuditEngagement? @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  workingPaperId String?
  workingPaper   AuditWorkingPaper? @relation(fields: [workingPaperId], references: [id], onDelete: Cascade)

  fileName String
  fileKey  String
  fileSize Int?
  mimeType String?

  // Marks the two files that release the completion gate
  kind String?

  uploadedById String?
  uploadedBy   User?   @relation("AuditAttachmentUploader", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@index([engagementId])
  @@index([workingPaperId])
  @@map("audit_attachments")
}
